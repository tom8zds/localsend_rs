# relay-panel: single-binary admin panel for the coturn deployment.
FROM rust:1-bookworm AS builder
WORKDIR /build
COPY rust/ .
RUN --mount=type=cache,target=/build/target \
    --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --release -p relay-panel \
    && cp target/release/relay-panel /usr/local/bin/relay-panel

FROM debian:bookworm-slim
COPY --from=builder /usr/local/bin/relay-panel /usr/local/bin/relay-panel
VOLUME /data
ENTRYPOINT ["relay-panel"]
